    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": ["https://app.dealdocs.example/api/integrations/hubspot/callback"],
      "requiredScopes": [
        "oauth",
        "crm.objects.deals.read",
        "crm.objects.deals.write",
        "crm.objects.contacts.read",
        "crm.objects.companies.read",
        "crm.objects.line_items.read",
        "crm.objects.owners.read",
        "crm.schemas.deals.read",
        "crm.schemas.deals.write",
        "e-commerce"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": ["https://app.dealdocs.example"],
      "iframe": [],
      "img": ["https://app.dealdocs.example"]
    },
    "support": {
      "supportEmail": "support@dealdocs.example",
      "documentationUrl": "https://app.dealdocs.example/legal/terms",
      "supportUrl": "https://app.dealdocs.example",
      "supportPhone": ""
