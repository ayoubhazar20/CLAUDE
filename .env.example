# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the DealDocs web app (no trailing slash).
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealdocs?schema=public

# 32-byte keys, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt integration secrets (Zapier) at rest.
ENCRYPTION_KEY=
# Used to HMAC session tokens, OTP codes and other one-time tokens.
SECRET_KEY=

# ── HubSpot via Zapier ───────────────────────────────────────────────
# DealDocs never calls HubSpot directly; Zapier bridges both directions.
# Default HubSpot custom object type id for documents (each organization can override it in
# Settings → Integrations → HubSpot via Zapier). Example: 2-12345678
HUBSPOT_DOCUMENT_OBJECT_TYPE_ID=
# Allowed hosts for outbound webhooks (comma separated).
ZAPIER_ALLOWED_HOSTS=hooks.zapier.com

# ── Email ─────────────────────────────────────────────────────────────
# "smtp" or "log" (log = print to server console; development only)
EMAIL_PROVIDER=log
EMAIL_FROM="DealDocs <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────
# "local" (private directory on persistent disk) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Jobs ──────────────────────────────────────────────────────────────
# "inline" runs the job worker inside the web process (single-server hosting);
# "external" expects `npm run worker` to be running as a separate process.
JOB_RUNNER=inline

# ── Platform bootstrap ───────────────────────────────────────────────
# Used by `npm run db:seed` / `tsx scripts/create-platform-admin.ts`
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Current legal document versions shown at sign-up.
TERMS_VERSION=2026-01
PRIVACY_VERSION=2026-01
