# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the DealDocs web app (no trailing slash).
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealdocs?schema=public

# 32-byte keys, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt HubSpot OAuth tokens and other integration secrets at rest.
ENCRYPTION_KEY=
# Used to HMAC session tokens, OTP codes and other one-time tokens.
SECRET_KEY=

# ── HubSpot (public app) ─────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Space-separated scopes requested at install time.
HUBSPOT_SCOPES="oauth crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read crm.objects.companies.read crm.objects.line_items.read crm.objects.owners.read crm.schemas.deals.read crm.schemas.deals.write e-commerce"
# Optional override (defaults to APP_URL/api/integrations/hubspot/callback)
HUBSPOT_REDIRECT_URI=

# ── Email ─────────────────────────────────────────────────────────────
# "smtp" or "log" (log = print to server console; development only)
EMAIL_PROVIDER=log
EMAIL_FROM="DealDocs <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────
# "local" (private directory on persistent disk) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Jobs ──────────────────────────────────────────────────────────────
# "inline" runs the job worker inside the web process (single-server hosting);
# "external" expects `npm run worker` to be running as a separate process.
JOB_RUNNER=inline

# ── Platform bootstrap ───────────────────────────────────────────────
# Used by `npm run db:seed` / `tsx scripts/create-platform-admin.ts`
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Current legal document versions shown at sign-up.
TERMS_VERSION=2026-01
PRIVACY_VERSION=2026-01
